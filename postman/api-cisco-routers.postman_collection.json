{
  "info": {
    "name": "API Cisco Routers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para autenticar, consultar usuarios y administrar roles de la API Laravel."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana López\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "User profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/auth/user",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "auth", "user"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/users",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "users"]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "users", "1"]
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Actualizada\",\n  \"email\": \"ana.nueva@example.com\",\n  \"password\": \"newPassword123\",\n  \"password_confirmation\": \"newPassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost/api/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "users", "1"]
            }
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List admin users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost/api/v1/admin/users?page=1",
              "protocol": "http",
              "host": ["localhost"],
              "path": ["api", "v1", "admin", "users"],
              "query": [{ "key": "page", "value": "1" }]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "token", "value": "tu_token_aqui" }
  ]
}
